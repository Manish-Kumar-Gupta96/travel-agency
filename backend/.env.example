APP_NAME="Enterprise Travel ERP"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travel_erp
DB_USERNAME=root
DB_PASSWORD=

# JWT Authentication
JWT_SECRET=change_this_secret_key
JWT_ISSUER=travel-erp-api

# Mail Configuration
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls

# Storage
UPLOAD_MAX_SIZE=10485760

# Cache
CACHE_DRIVER=file
