{
  "name": "travel-agency-react",
  "private": true,
  "version": "1.0.0",
  "description": "Enterprise Travel Agency Website built with React 19 + Vite",
  "author": "Manish Gupta",
  "license": "MIT",
  "type": "module",
  "homepage": "/",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "format": "prettier --write .",
    "check-format": "prettier --check .",
    "clean": "rimraf dist",
    "rebuild": "npm run clean && npm install && npm run build"
  },
  "dependencies": {
    "axios": "^1.11.0",
    "chart.js": "^4.5.0",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.23.12",
    "react": "^19.1.1",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^19.1.1",
    "react-helmet-async": "^2.0.5",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-loading-skeleton": "^3.5.0",
    "react-router-dom": "^7.8.2",
    "swiper": "^11.2.10",
    "zod": "^4.1.5",
    "@tanstack/react-table": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "^9.33.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "rimraf": "^6.0.1",
    "vite": "^7.1.2"
  },
  "keywords": [
    "travel",
    "travel-agency",
    "tourism",
    "booking",
    "hotel",
    "react",
    "vite",
    "javascript",
    "frontend",
    "responsive",
    "admin-panel"
  ],
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 edge version"
    ]
  }
}
